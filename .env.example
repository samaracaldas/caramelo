# Connection string do Neon (Dashboard > Connect). Sem ela, o dev usa PGlite em .data/
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Segredo do JWT de sessão. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-isto

# Botão "Ver demonstração". Padrão: ligado
# DEMO_LOGIN=false

# Opcional: liga o "Ler comprovante" (Pix, nota fiscal, boleto) com o Claude.
# Sem ela o botão não aparece e o resto do app funciona igual. Crie em console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
